# Настройки конкретной машины и секреты
/env.yaml
/secrets.yaml

# Пространства и задачи этой копии: код, worktree, вложения
/workspaces/*
!/workspaces/.gitkeep

# Учёт ведётся локально
/registry/WORKTREES.md

# Настройки прокси этой машины (пример: conf/settings.local.example.json)
/infra/nginx-env/conf/settings.local.json

# Генерируемые файлы прокси
/infra/nginx-env/var/
/infra/nginx-env/stands.d/*
!/infra/nginx-env/stands.d/.gitkeep

# Служебный мусор
__pycache__/
*.pyc
.DS_Store
