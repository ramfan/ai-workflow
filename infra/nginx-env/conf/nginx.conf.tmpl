# Шаблон. bin/envctl подставляет @...@ и пишет результат в var/nginx.conf.
# Править здесь, затем: bin/envctl reload

daemon on;
worker_processes 1;
pid @VAR@/nginx.pid;
error_log @VAR@/logs/error.log warn;

events {
    worker_connections 1024;
}

http {
    include @MIME_TYPES@;
    default_type application/octet-stream;

    access_log @VAR@/logs/access.log;

    client_body_temp_path @VAR@/temp/client_body;
    proxy_temp_path       @VAR@/temp/proxy;
    fastcgi_temp_path     @VAR@/temp/fastcgi;
    uwsgi_temp_path       @VAR@/temp/uwsgi;
    scgi_temp_path        @VAR@/temp/scgi;

    sendfile on;
    client_max_body_size 2g;

    # Внешний порт отличается от внутреннего: в Location должны быть только
    # относительные адреса, иначе браузер уйдёт на закрытый внутренний порт.
    absolute_redirect off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    include @CONF@/proxy_headers.conf;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_buffering off;
    proxy_request_buffering off;

    server {
        listen @LISTEN_PORT@ default_server;

        location = / { return 302 /_env/; }

        # Служебное пространство имён. Стендам не отдавать.
        location = /_env { return 302 /_env/; }
        location /_env/ {
            alias @PANEL@/;
            index index.html;
            add_header Cache-Control "no-store";
        }
        location = /_env/api/stands.json {
            alias @STANDS_JSON@;
            default_type application/json;
            add_header Cache-Control "no-store";
        }
        # Команды панели (остановка и удаление стендов) — сервис envctl api.
        location /_env/api/ {
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_connect_timeout 2s;
            proxy_read_timeout 60s;
            proxy_pass http://127.0.0.1:@CONTROL_PORT@;
        }
        location = /_env/health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        include @ROUTES@;

        # Монитор ресурсов контейнера (RAM/CPU по процессам + kill).
        # Отдельный сервис personal-persistent/services/infra/resmon, слушает только
        # loopback; его порт — единственный владелец RESMON_PORT в <resmon>/.env.
        # Здесь путь монтируется, чтобы не занимать внешний порт вторым листенером.
        # proxy_buffering off (см. http {}) обязателен: у монитора SSE-поток.
        location = /resmon { return 302 /resmon/; }
        location ^~ /resmon/ {
            include @CONF@/proxy_headers.conf;
            proxy_connect_timeout 2s;
            proxy_read_timeout 1h;
            proxy_pass http://127.0.0.1:10099/;
        }

        # Общего catch-all нет: у каждого стенда свой префикс.
        location / {
            default_type text/html;
            return 404 '<!doctype html><meta charset="utf-8"><title>404</title><p>Такого стенда нет. <a href="/_env/">Список стендов</a></p>';
        }
    }
}
